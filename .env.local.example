## Whop (Bizko Pro subscriptions)
# Sandbox: https://sandbox-api.whop.com/api/v1 | Live: https://api.whop.com/api/v1
WHOP_BASE_URL=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Company/account id (biz_...) required to list memberships with an API key.
WHOP_COMPANY_ID=
# Monthly Pro plan id (mandatory). Yearly is optional; falls back to monthly if unset.
WHOP_PLAN_ID_PRO=
WHOP_PLAN_ID_PRO_YEARLY=
# Where Whop redirects the buyer after checkout. Optional; defaults to /dashboard?success=pro.
WHOP_CHECKOUT_REDIRECT_URL=

## Photoshop-style limit overrides (optional, defaults in src/lib/plans.ts)
# BILLING_MODE=sandbox
