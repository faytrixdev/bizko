## Whop (Bizko Pro subscriptions)
# Sandbox: https://sandbox-api.whop.com/api/v1 | Live: https://api.whop.com/api/v1
# IMPORTANT: WHOP_BASE_URL and WHOP_API_KEY must match (sandbox key <=> sandbox URL,
# live key <=> live URL) AND be consistent between Vercel and local. A mismatch
# returns 401 Unauthorized on checkout creation.
WHOP_BASE_URL=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Company/account id (biz_...) required to list memberships with an API key.
WHOP_COMPANY_ID=
# Monthly Pro plan id (mandatory). Yearly is optional; falls back to monthly if unset.
WHOP_PLAN_ID_PRO=
WHOP_PLAN_ID_PRO_YEARLY=
# Where Whop redirects the buyer after checkout. Optional; defaults to /dashboard?success=pro.
WHOP_CHECKOUT_REDIRECT_URL=

## Chariow (Bizko Pro — Mobile Money)
# Live: https://api.chariow.com/v1 (override only if Chariow provides a sandbox base)
CHARIOW_BASE_URL=
CHARIOW_API_KEY=
# Pulse signing secret (whsec_...) from Automations → Pulses → Overview tab.
CHARIOW_PULSE_SECRET=
# Monthly Pro product id (mandatory). Yearly is optional; falls back to monthly if unset.
CHARIOW_PRODUCT_ID_PRO=
CHARIOW_PRODUCT_ID_PRO_YEARLY=
# Where Chariow redirects the buyer after payment. Optional; defaults to /dashboard?success=pro.
CHARIOW_CHECKOUT_REDIRECT_URL=

## Photoshop-style limit overrides (optional, defaults in src/lib/plans.ts)
# BILLING_MODE=sandbox
